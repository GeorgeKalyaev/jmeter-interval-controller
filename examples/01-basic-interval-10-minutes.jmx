<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="01-basic-interval-10-minutes" enabled="true">
      <stringProp name="TestPlan.comments">DEMO: Production recommendation is Execution Interval=10 Minutes. This file uses 2 SECONDS so Non-GUI demos finish quickly. Expected with 6 loops and ~1s pacing: nested sampler runs on first encounter and again after ~2s; siblings run every loop.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Thread Group" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <stringProp name="LoopController.loops">6</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <com.example.jmeter.interval.IntervalController guiclass="com.example.jmeter.interval.IntervalControllerGui" testclass="com.example.jmeter.interval.IntervalController" testname="Interval Controller" enabled="true">
          <stringProp name="IntervalController.intervalValue">2</stringProp>
          <stringProp name="IntervalController.timeUnit">SECONDS</stringProp>
          <boolProp name="IntervalController.executeOnFirstIteration">true</boolProp>
          <stringProp name="IntervalController.intervalMode">EXECUTION_COMPLETION</stringProp>
          <boolProp name="IntervalController.retryOnFailure">false</boolProp>
          <stringProp name="IntervalController.retryDelay">5</stringProp>
          <stringProp name="IntervalController.retryDelayUnit">SECONDS</stringProp>
          <longProp name="IntervalController.maxRetries">0</longProp>
          <stringProp name="IntervalController.jitterValue">0</stringProp>
          <stringProp name="IntervalController.jitterUnit">SECONDS</stringProp>
          <stringProp name="IntervalController.jitterMode">POSITIVE</stringProp>
          <boolProp name="IntervalController.dynamicInterval">false</boolProp>
          <stringProp name="IntervalController.tokenExpirationVar"></stringProp>
          <stringProp name="IntervalController.tokenIssuedAtVar"></stringProp>
          <stringProp name="IntervalController.expirationFormat">UNIX_MILLISECONDS</stringProp>
          <stringProp name="IntervalController.refreshBefore">30</stringProp>
          <stringProp name="IntervalController.refreshBeforeUnit">SECONDS</stringProp>
          <stringProp name="IntervalController.forceRefreshVar">interval_controller_force_refresh</stringProp>
        </com.example.jmeter.interval.IntervalController>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Work Inside Interval" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script"><![CDATA[
SampleResult.setSuccessful(true)
SampleResult.setResponseCode("200")
SampleResult.setResponseMessage("inside-interval")
]]></stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Always Outside" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script"><![CDATA[
Thread.sleep(1000)
SampleResult.setSuccessful(true)
SampleResult.setResponseCode("200")
SampleResult.setResponseMessage("outside")
]]></stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
