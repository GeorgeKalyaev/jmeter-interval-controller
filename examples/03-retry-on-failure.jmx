<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="03-retry-on-failure" enabled="true">
      <stringProp name="TestPlan.comments">DEMO: Nested sampler fails twice then succeeds. Retry on Failure enabled, Retry Delay 200ms, Max Retries 5. Interval is large so retries (not interval) drive re-entry. Expected: several FlakyAuth samples until success, then skips until interval (not reached in short run).</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Thread Group" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <stringProp name="LoopController.loops">8</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <com.example.jmeter.interval.IntervalController guiclass="com.example.jmeter.interval.IntervalControllerGui" testclass="com.example.jmeter.interval.IntervalController" testname="Retry Demo IC" enabled="true">
          <stringProp name="IntervalController.intervalValue">1</stringProp>
          <stringProp name="IntervalController.timeUnit">HOURS</stringProp>
          <boolProp name="IntervalController.executeOnFirstIteration">true</boolProp>
          <stringProp name="IntervalController.intervalMode">EXECUTION_COMPLETION</stringProp>
          <boolProp name="IntervalController.retryOnFailure">true</boolProp>
          <stringProp name="IntervalController.retryDelay">200</stringProp>
          <stringProp name="IntervalController.retryDelayUnit">MILLISECONDS</stringProp>
          <longProp name="IntervalController.maxRetries">5</longProp>
          <stringProp name="IntervalController.jitterValue">0</stringProp>
          <stringProp name="IntervalController.jitterUnit">SECONDS</stringProp>
          <stringProp name="IntervalController.jitterMode">POSITIVE</stringProp>
          <boolProp name="IntervalController.dynamicInterval">false</boolProp>
          <stringProp name="IntervalController.tokenExpirationVar"></stringProp>
          <stringProp name="IntervalController.tokenIssuedAtVar"></stringProp>
          <stringProp name="IntervalController.expirationFormat">UNIX_MILLISECONDS</stringProp>
          <stringProp name="IntervalController.refreshBefore">30</stringProp>
          <stringProp name="IntervalController.refreshBeforeUnit">SECONDS</stringProp>
          <stringProp name="IntervalController.forceRefreshVar">interval_controller_force_refresh</stringProp>
        </com.example.jmeter.interval.IntervalController>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Flaky Auth" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script"><![CDATA[
def n = ((vars.get("attempt") ?: "0") as int) + 1
vars.put("attempt", n.toString())
Thread.sleep(50)
if (n <= 2) {
  SampleResult.setSuccessful(false)
  SampleResult.setResponseCode("503")
  SampleResult.setResponseMessage("simulated-failure-" + n)
} else {
  SampleResult.setSuccessful(true)
  SampleResult.setResponseCode("200")
  SampleResult.setResponseMessage("ok-after-retries")
}
]]></stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Pace" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script"><![CDATA[
Thread.sleep(250)
SampleResult.setSuccessful(true)
]]></stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
