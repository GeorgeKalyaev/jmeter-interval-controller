<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="05-token-expiration-and-force-refresh" enabled="true">
      <stringProp name="TestPlan.comments">DEMO: Large interval (1 hour) so normal window would SKIP. Loop 2 sets force_refresh=true → FORCE execute. TTL variable token_ttl_seconds=2 with format TTL_SECONDS also drives refresh after issued-at binding. Simulated tokens only.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Thread Group" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <stringProp name="LoopController.loops">6</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Init / Maybe Force" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script"><![CDATA[
if (vars.get("token_ttl_seconds") == null) {
  vars.put("token_ttl_seconds", "2")
}
def n = ((vars.get("force_tick") ?: "0") as int) + 1
vars.put("force_tick", n.toString())
if (n == 2) {
  vars.put("interval_controller_force_refresh", "true")
}
SampleResult.setSuccessful(true)
]]></stringProp>
        </JSR223Sampler>
        <hashTree/>
        <com.example.jmeter.interval.IntervalController guiclass="com.example.jmeter.interval.IntervalControllerGui" testclass="com.example.jmeter.interval.IntervalController" testname="Token / Force IC" enabled="true">
          <stringProp name="IntervalController.intervalValue">1</stringProp>
          <stringProp name="IntervalController.timeUnit">HOURS</stringProp>
          <boolProp name="IntervalController.executeOnFirstIteration">true</boolProp>
          <stringProp name="IntervalController.intervalMode">EXECUTION_COMPLETION</stringProp>
          <boolProp name="IntervalController.retryOnFailure">false</boolProp>
          <stringProp name="IntervalController.retryDelay">5</stringProp>
          <stringProp name="IntervalController.retryDelayUnit">SECONDS</stringProp>
          <longProp name="IntervalController.maxRetries">0</longProp>
          <stringProp name="IntervalController.jitterValue">0</stringProp>
          <stringProp name="IntervalController.jitterUnit">SECONDS</stringProp>
          <stringProp name="IntervalController.jitterMode">POSITIVE</stringProp>
          <boolProp name="IntervalController.dynamicInterval">false</boolProp>
          <stringProp name="IntervalController.tokenExpirationVar">token_ttl_seconds</stringProp>
          <stringProp name="IntervalController.tokenIssuedAtVar"></stringProp>
          <stringProp name="IntervalController.expirationFormat">TTL_SECONDS</stringProp>
          <stringProp name="IntervalController.refreshBefore">0</stringProp>
          <stringProp name="IntervalController.refreshBeforeUnit">SECONDS</stringProp>
          <stringProp name="IntervalController.forceRefreshVar">interval_controller_force_refresh</stringProp>
        </com.example.jmeter.interval.IntervalController>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Refresh Token (simulated)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script"><![CDATA[
def n = ((vars.get("refresh_count") ?: "0") as int) + 1
vars.put("refresh_count", n.toString())
vars.put("access_token", "ttl-demo-" + n)
SampleResult.setSuccessful(true)
SampleResult.setResponseMessage("refreshed-" + n)
]]></stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Pace" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script"><![CDATA[
Thread.sleep(1100)
SampleResult.setSuccessful(true)
]]></stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
