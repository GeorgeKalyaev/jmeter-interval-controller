<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="02-authentication-refresh" enabled="true">
      <stringProp name="TestPlan.comments">DEMO — Run Authentication Once Every 10 Minutes (structure). Production: Interval=10 Minutes. This demo uses 2 SECONDS. Simulated login only — no real credentials or endpoints. Expected: Auth runs on first encounter and after interval; API samplers every loop.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Thread Group" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <stringProp name="LoopController.loops">6</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <com.example.jmeter.interval.IntervalController guiclass="com.example.jmeter.interval.IntervalControllerGui" testclass="com.example.jmeter.interval.IntervalController" testname="Refresh Authentication" enabled="true">
          <stringProp name="IntervalController.intervalValue">2</stringProp>
          <stringProp name="IntervalController.timeUnit">SECONDS</stringProp>
          <boolProp name="IntervalController.executeOnFirstIteration">true</boolProp>
          <stringProp name="IntervalController.intervalMode">EXECUTION_COMPLETION</stringProp>
          <boolProp name="IntervalController.retryOnFailure">false</boolProp>
          <stringProp name="IntervalController.retryDelay">5</stringProp>
          <stringProp name="IntervalController.retryDelayUnit">SECONDS</stringProp>
          <longProp name="IntervalController.maxRetries">0</longProp>
          <stringProp name="IntervalController.jitterValue">0</stringProp>
          <stringProp name="IntervalController.jitterUnit">SECONDS</stringProp>
          <stringProp name="IntervalController.jitterMode">POSITIVE</stringProp>
          <boolProp name="IntervalController.dynamicInterval">false</boolProp>
          <stringProp name="IntervalController.tokenExpirationVar"></stringProp>
          <stringProp name="IntervalController.tokenIssuedAtVar"></stringProp>
          <stringProp name="IntervalController.expirationFormat">UNIX_MILLISECONDS</stringProp>
          <stringProp name="IntervalController.refreshBefore">30</stringProp>
          <stringProp name="IntervalController.refreshBeforeUnit">SECONDS</stringProp>
          <stringProp name="IntervalController.forceRefreshVar">interval_controller_force_refresh</stringProp>
        </com.example.jmeter.interval.IntervalController>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="POST /login (simulated)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script"><![CDATA[
// Simulated authentication — NOT a real login server
def n = ((vars.get("auth_count") ?: "0") as int) + 1
vars.put("auth_count", n.toString())
vars.put("access_token", "demo-token-" + n)
SampleResult.setSuccessful(true)
SampleResult.setResponseCode("200")
SampleResult.setResponseMessage("simulated-login")
SampleResult.setResponseData('{"access_token":"' + vars.get("access_token") + '"}', "UTF-8")
]]></stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GET /api/orders (simulated)" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script"><![CDATA[
def token = vars.get("access_token")
if (token == null || token.isEmpty()) {
  SampleResult.setSuccessful(false)
  SampleResult.setResponseMessage("missing-token")
} else {
  Thread.sleep(1000)
  SampleResult.setSuccessful(true)
  SampleResult.setResponseCode("200")
  SampleResult.setResponseMessage("orders ok token=" + token)
}
]]></stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GET /api/profile (simulated)" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script"><![CDATA[
def token = vars.get("access_token")
SampleResult.setSuccessful(token != null && !token.isEmpty())
SampleResult.setResponseCode(SampleResult.isSuccessful() ? "200" : "401")
SampleResult.setResponseMessage(SampleResult.isSuccessful() ? "profile ok" : "missing-token")
]]></stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
